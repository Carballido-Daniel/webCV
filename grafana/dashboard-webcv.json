  "from": "now-7d",
  "to": "now"
 },
 "refresh": "5m",
 "templating": {
  "list": [
   {
    "name": "selector",
    "label": "Selector de logs",
    "type": "textbox",
    "query": "{app_id=\"378\"}",
    "current": {
     "text": "{app_id=\"378\"}",
     "value": "{app_id=\"378\"}"
    },
    "description": "Selector de stream de Loki con los datos de Faro. Ajústalo si en Explore tus logs tienen otras etiquetas."
   }
  ]
 },
