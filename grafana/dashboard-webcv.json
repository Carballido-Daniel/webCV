      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "quantile_over_time(0.75, $selector | logfmt | kind=\"measurement\" | type=\"page_load\" | load_ms!=\"\" | unwrap load_ms | __error__=\"\" [$__range]) by ()",
     "legendFormat": "",
     "queryType": "instant",
     "editorMode": "code"
